@{
    ViewData["Title"] = "Trung Tâm Báo Cáo & Thống Kê";
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-bar-chart-line text-primary me-2"></i>Báo Cáo Thống Kê Theo Yêu Cầu Đề Tài</h5>

    <div class="row g-4">
        <!-- Báo cáo 1: Yêu cầu 6 -->
        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-warning me-3"><i class="bi bi-trophy-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Top 3 Sản Phẩm Bán Chạy Nhất Theo Quý</h6>
                        <small class="text-muted">(Yêu cầu số 6 trong file Excel)</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo danh sách 3 sản phẩm tủ bếp bán được nhiều nhất trong một quý chọn trước, kèm theo tổng số lượng và doanh thu.</p>
                <a asp-action="Top3SanPhamTheoQuy" class="btn btn-outline-warning btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Báo cáo 2: Yêu cầu 8 -->
        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-danger me-3"><i class="bi bi-arrow-down-circle-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Top 5 Hoá Đơn Bán Hàng Nhỏ Nhất Theo Quý</h6>
                        <small class="text-muted">(Yêu cầu số 8 trong file Excel)</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo chi tiết danh sách 5 hoá đơn có tổng tiền bán hàng nhỏ nhất theo quý chọn trước nhằm khảo sát phân khúc khách hàng lẻ.</p>
                <a asp-action="Top5HoaDonNhoNhatTheoQuy" class="btn btn-outline-danger btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Báo cáo 3: Yêu cầu 9 -->
        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-success me-3"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Danh Sách Khách Hàng Mua Hàng Theo Tháng</h6>
                        <small class="text-muted">(Yêu cầu số 9 trong file Excel)</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo thống kê toàn bộ khách hàng đã phát sinh giao dịch mua hàng trong một tháng chọn trước, kèm số lượt mua và tổng tiền.</p>
                <a asp-action="KhachHangTheoThang" class="btn btn-outline-success btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
