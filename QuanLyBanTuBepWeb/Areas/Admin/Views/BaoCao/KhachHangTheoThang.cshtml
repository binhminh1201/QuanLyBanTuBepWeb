@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Khách Hàng Mua Hàng Theo Tháng";
    int nam = ViewBag.Nam;
    int thang = ViewBag.Thang;
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill text-success me-2"></i>Danh Sách Khách Hàng Mua Hàng (Tháng @thang / @nam)</h5>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Filter form -->
    <form asp-action="KhachHangTheoThang" method="get" class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded-3">
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted fw-bold mb-0">Năm:</label>
            <input type="number" name="nam" class="form-control form-control-sm" style="width: 100px;" value="@nam" min="2020" max="2035" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted fw-bold mb-0">Tháng:</label>
            <select name="thang" class="form-select form-select-sm" style="width: 120px;">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(thang == m ? "selected" : null)">Tháng @m</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-3"><i class="bi bi-funnel-fill me-1"></i>Xem báo cáo</button>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Mã khách</th>
                    <th>Họ và tên khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th class="text-center">Số lượt mua</th>
                    <th class="text-end">Tổng tiền chi tiêu</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.MaKhach</td>
                            <td class="fw-semibold">@item.TenKhach</td>
                            <td>@(item.DienThoai ?? "-")</td>
                            <td>@(item.DiaChi ?? "-")</td>
                            <td class="text-center fw-bold">@item.SoDonHang đơn</td>
                            <td class="text-end fw-bold text-danger fs-6">@(((decimal)item.TongChiTieu).ToString("N0")) đ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Không có khách hàng mua hàng trong Tháng @thang năm @nam</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
