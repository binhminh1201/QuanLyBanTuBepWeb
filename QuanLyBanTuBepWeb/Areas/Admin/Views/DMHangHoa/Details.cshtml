@model QuanLyBanTuBepWeb.Models.DMHangHoa
@{
    ViewData["Title"] = "Chi Tiết Tủ Bếp: " + Model.MaHang;
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-info-circle text-info me-2"></i>Thông Tin Chi Tiết Sản Phẩm Tủ Bếp</h5>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.MaHang" class="btn btn-primary btn-sm px-3 me-2">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4 text-center">
            <img src="/images/products/@(string.IsNullOrEmpty(Model.Anh) ? "no_image.png" : Model.Anh)" class="img-fluid rounded-3 border p-2 shadow-sm" alt="@Model.TenHang" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
        </div>
        <div class="col-md-8">
            <table class="table table-bordered small">
                <tbody>
                    <tr>
                        <th class="bg-light" style="width: 30%;">Mã hàng:</th>
                        <td class="fw-bold text-primary">@Model.MaHang</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Tên hàng hoá:</th>
                        <td class="fw-bold">@Model.TenHang</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Chất liệu:</th>
                        <td>@(Model.ChatLieu?.TenChatLieu ?? "-")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Màu sắc:</th>
                        <td>@(Model.MauSac?.TenMau ?? "-")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Kích thước:</th>
                        <td>@(Model.KichThuoc?.TenKichThuoc ?? "-")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Nước sản xuất:</th>
                        <td>@(Model.NuocSanXuat?.TenNuocSX ?? "-")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Số lượng tồn kho:</th>
                        <td><span class="badge @(Model.SoLuong <= 2 ? "bg-danger" : "bg-success") px-2 py-1">@Model.SoLuong bộ</span></td>
                    </tr>
                    <tr>
                        <th class="bg-light">Giá nhập:</th>
                        <td>@Model.GiaNhap?.ToString("N0") đ</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Đơn giá bán:</th>
                        <td class="fw-bold text-danger fs-6">@Model.DonGiaBan?.ToString("N0") đ</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Thời gian bảo hành:</th>
                        <td>@Model.ThoiGianBaoHanh</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Ghi chú / Mô tả:</th>
                        <td>@Model.GhiChu</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
