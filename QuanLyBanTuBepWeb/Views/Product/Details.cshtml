@model QuanLyBanTuBepWeb.Models.DMHangHoa
@{
    ViewData["Title"] = Model.TenHang;
    var related = ViewBag.RelatedProducts as IEnumerable<QuanLyBanTuBepWeb.Models.DMHangHoa>;
}

<!-- Breadcrumb -->
<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Tủ Bếp</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.TenHang</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <!-- Product Image -->
            <div class="col-lg-6 p-4 text-center bg-light d-flex align-items-center justify-content-center">
                <img src="/images/products/@(string.IsNullOrEmpty(Model.Anh) ? "no_image.png" : Model.Anh)" class="img-fluid rounded-3 shadow-sm" alt="@Model.TenHang" style="max-height: 420px; width: auto;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
            </div>

            <!-- Product Specs and Buy Form -->
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">Mã: @Model.MaHang</span>
                        <span class="badge @(Model.SoLuong > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-1 rounded-pill">
                            @(Model.SoLuong > 0 ? $"Còn {Model.SoLuong} sản phẩm" : "Hết hàng")
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">@Model.TenHang</h2>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <small class="text-muted d-block mb-1">Giá bán niêm yết:</small>
                        <span class="display-6 fw-bold text-danger">@Model.DonGiaBan?.ToString("N0") đ</span>
                        <span class="text-muted small ms-2">(Đã bao gồm VAT và công lắp đặt cơ bản)</span>
                    </div>

                    <!-- Specification Table -->
                    <h6 class="fw-bold text-dark mb-3">Thông số kỹ thuật sản phẩm:</h6>
                    <table class="table table-bordered table-sm small mb-4">
                        <tbody>
                            <tr>
                                <th class="bg-light" style="width: 40%;">Chất liệu thùng & cánh:</th>
                                <td><strong>@(Model.ChatLieu?.TenChatLieu ?? "N/A")</strong></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Màu sắc chủ đạo:</th>
                                <td>@(Model.MauSac?.TenMau ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Kích thước chuẩn:</th>
                                <td>@(Model.KichThuoc?.TenKichThuoc ?? "Theo yêu cầu")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Nước sản xuất / Nhập khẩu:</th>
                                <td>@(Model.NuocSanXuat?.TenNuocSX ?? "Việt Nam")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Thời gian bảo hành:</th>
                                <td><span class="text-success fw-bold"><i class="bi bi-shield-check me-1"></i>@(Model.ThoiGianBaoHanh ?? "24 tháng")</span></td>
                            </tr>
                        </tbody>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">Mô tả đặc tính:</h6>
                            <p class="small text-muted mb-0">@Model.GhiChu</p>
                        </div>
                    }
                </div>

                <!-- Add to cart action -->
                <div class="pt-3 border-top">
                    @if (Model.SoLuong > 0)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="input-group" style="width: 130px;">
                                <button class="btn btn-outline-secondary" type="button" id="btnMinus"><i class="bi bi-dash"></i></button>
                                <input type="number" id="inputQuantity" class="form-control text-center" value="1" min="1" max="@Model.SoLuong">
                                <button class="btn btn-outline-secondary" type="button" id="btnPlus"><i class="bi bi-plus"></i></button>
                            </div>
                            <button id="btnAddToCart" class="btn btn-primary-custom btn-lg flex-grow-1 fw-bold shadow-sm" data-id="@Model.MaHang">
                                <i class="bi bi-cart-plus me-2"></i> Thêm Vào Giỏ Hàng
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100 fw-bold" disabled>
                            <i class="bi bi-x-circle me-2"></i> Sản phẩm đang tạm hết hàng
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related != null && related.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-4">Các Mẫu Tủ Bếp Cùng Chất Liệu Liên Quan</h4>
            <div class="row g-4">
                @foreach (var item in related)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="card card-product h-100 shadow-sm">
                            <div style="height: 180px; overflow: hidden; background-color: #f1f5f9;">
                                <a asp-action="Details" asp-route-id="@item.MaHang">
                                    <img src="/images/products/@(string.IsNullOrEmpty(item.Anh) ? "no_image.png" : item.Anh)" class="card-img-top product-img" alt="@item.TenHang" style="height: 180px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                                </a>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <h6 class="card-title fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@item.MaHang" class="text-decoration-none text-dark">@item.TenHang</a>
                                </h6>
                                <div class="fw-bold text-danger mt-2">@item.DonGiaBan?.ToString("N0") đ</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var maxQty = @(Model.SoLuong ?? 0);

            $("#btnMinus").click(function () {
                var val = parseInt($("#inputQuantity").val()) || 1;
                if (val > 1) $("#inputQuantity").val(val - 1);
            });

            $("#btnPlus").click(function () {
                var val = parseInt($("#inputQuantity").val()) || 1;
                if (val < maxQty) $("#inputQuantity").val(val + 1);
            });

            $("#btnAddToCart").click(function () {
                var qty = parseInt($("#inputQuantity").val()) || 1;
                var id = $(this).data("id");

                $.ajax({
                    url: "/Cart/AddToCart",
                    type: "POST",
                    data: { id: id, quantity: qty },
                    success: function (res) {
                        if (res.success) {
                            $("#cartCountBadge").text(res.totalCount);
                            $("#toastMessage").html('<i class="bi bi-check-circle-fill me-2"></i>' + res.message);
                            var toast = new bootstrap.Toast($('#cartToast'));
                            toast.show();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });
        });
    </script>
}
