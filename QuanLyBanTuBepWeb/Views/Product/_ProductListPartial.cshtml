@model QuanLyBanTuBepWeb.Models.ViewModels.ProductFilterVM

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm (Trang @Model.CurrentPage / @Model.TotalPages)
    </div>
</div>

@if (!Model.DanhSachHangHoa.Any())
{
    <div class="text-center py-5 bg-white rounded-3 border">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-secondary">Không tìm thấy sản phẩm tủ bếp phù hợp</h5>
        <p class="small text-muted">Vui lòng thử chọn lại tiêu chí lọc hoặc xóa từ khóa tìm kiếm.</p>
        <button id="btnResetFilter" class="btn btn-outline-primary btn-sm rounded-pill mt-2">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa tất cả bộ lọc
        </button>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.DanhSachHangHoa)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card card-product h-100 shadow-sm">
                    <div class="position-relative" style="height: 220px; overflow: hidden; background-color: #f1f5f9;">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaHang">
                            <img src="/images/products/@(string.IsNullOrEmpty(item.Anh) ? "no_image.png" : item.Anh)" class="card-img-top product-img" alt="@item.TenHang" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                        </a>
                        <span class="position-absolute top-0 end-0 bg-primary text-white px-2 py-1 m-2 rounded small fw-bold">
                            @(item.NuocSanXuat?.TenNuocSX ?? "Nhập khẩu")
                        </span>
                        @if (item.SoLuong <= 0)
                        {
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded small fw-bold">
                                Tạm hết hàng
                            </span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <div class="small text-muted mb-1">
                            <span class="badge bg-secondary-subtle text-secondary me-1">@item.ChatLieu?.TenChatLieu</span>
                            <span class="badge bg-info-subtle text-info">@item.MauSac?.TenMau</span>
                        </div>
                        <h6 class="card-title fw-bold mb-2">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaHang" class="text-decoration-none text-dark">
                                @item.TenHang
                            </a>
                        </h6>
                        <p class="small text-muted flex-grow-1 mb-2">
                            <i class="bi bi-arrows-fullscreen me-1"></i> @item.KichThuoc?.TenKichThuoc<br />
                            <i class="bi bi-shield-check me-1"></i> Bảo hành: @item.ThoiGianBaoHanh
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">Giá bán:</small>
                                <span class="fw-bold text-danger fs-6">@item.DonGiaBan?.ToString("N0") đ</span>
                            </div>
                            @if (item.SoLuong > 0)
                            {
                                <button class="btn btn-primary-custom btn-sm px-3 rounded-pill btn-add-cart" data-id="@item.MaHang">
                                    <i class="bi bi-cart-plus"></i> Chọn
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm px-3 rounded-pill" disabled>Hết hàng</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Phân trang AJAX (Lab 6) -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link ajax-page-link" href="#" data-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
