@model QuanLyBanTuBepWeb.Models.ViewModels.ProductFilterVM
@{
    ViewData["Title"] = "Bộ Sưu Tập Tủ Bếp";
}

<!-- Page Header Breadcrumb -->
<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bộ sưu tập Tủ Bếp</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Sidebar Filter ViewComponent -->
        @await Component.InvokeAsync("ProductFilterSidebar", Model)

        <!-- Main Product Listing Section -->
        <div class="col-lg-9">
            <!-- Sort and Header Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-3 border rounded-2 shadow-sm mb-4">
                <h4 class="fw-bold mb-0 text-dark">Sản Phẩm Tủ Bếp</h4>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0 text-nowrap">Sắp xếp:</label>
                    <select id="selectSort" class="form-select form-select-sm" style="width: auto;">
                        <option value="">Mới nhất</option>
                        <option value="price_asc">Giá: Thấp đến Cao</option>
                        <option value="price_desc">Giá: Cao đến Thấp</option>
                        <option value="name_asc">Tên: A - Z</option>
                    </select>
                </div>
            </div>

            <!-- Loading Spinner (AJAX) -->
            <div id="loadingSpinner" class="text-center py-5 d-none">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải dữ liệu...</span>
                </div>
                <div class="small text-muted mt-2">Đang nạp danh sách tủ bếp...</div>
            </div>

            <!-- Container được cập nhật bất đồng bộ qua AJAX -->
            <div id="productContainer">
                <partial name="_ProductListPartial" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentPage = 1;

            // Hàm gọi AJAX tải lại danh sách sản phẩm
            function loadProducts(page) {
                if (page) currentPage = page;

                var keyword = $("#keywordInput").val();
                var maChatLieu = $("#selectChatLieu").val();
                var maMau = $("#selectMauSac").val();
                var maKichThuoc = $("#selectKichThuoc").val();
                var maNuocSX = $("#selectNuocSX").val();
                var sapXep = $("#selectSort").val();

                var giaTu = "";
                var giaDen = "";
                var priceRange = $('input[name="priceRange"]:checked').val();
                if (priceRange) {
                    var parts = priceRange.split("-");
                    giaTu = parts[0];
                    giaDen = parts[1];
                }

                $("#loadingSpinner").removeClass("d-none");
                $("#productContainer").addClass("opacity-50");

                $.ajax({
                    url: "/Product/FilterProducts",
                    type: "GET",
                    data: {
                        keyword: keyword,
                        maChatLieu: maChatLieu,
                        maMau: maMau,
                        maKichThuoc: maKichThuoc,
                        maNuocSX: maNuocSX,
                        giaTu: giaTu,
                        giaDen: giaDen,
                        sapXep: sapXep,
                        page: currentPage
                    },
                    success: function (html) {
                        $("#productContainer").html(html);
                        $("#loadingSpinner").addClass("d-none");
                        $("#productContainer").removeClass("opacity-50");

                        // Cuộn mượt lên đầu danh sách sản phẩm
                        $('html, body').animate({
                            scrollTop: $("#productContainer").offset().top - 100
                        }, 200);
                    },
                    error: function (xhr) {
                        $("#loadingSpinner").addClass("d-none");
                        $("#productContainer").removeClass("opacity-50");
                        alert("Lỗi tải dữ liệu: " + xhr.statusText);
                    }
                });
            }

            // Bắt sự kiện thay đổi các bộ lọc dropdown và radio
            $(".filter-input, .filter-radio-price, #selectSort").change(function () {
                loadProducts(1);
            });

            // Bắt sự kiện bấm nút tìm kiếm từ khóa
            $("#btnSearchKeyword").click(function () {
                loadProducts(1);
            });

            // Tìm kiếm khi gõ Enter
            $("#keywordInput").keypress(function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadProducts(1);
                }
            });

            // Bắt sự kiện click vào nút phân trang AJAX (Event Delegation)
            $("body").on("click", ".ajax-page-link", function (e) {
                e.preventDefault();
                var page = $(this).data("page");
                if (page) {
                    loadProducts(page);
                }
            });

            // Nút xóa tất cả bộ lọc
            $("body").on("click", "#btnResetFilter, #btnResetAll", function () {
                $("#keywordInput").val("");
                $("#selectChatLieu").val("");
                $("#selectMauSac").val("");
                $("#selectKichThuoc").val("");
                $("#selectNuocSX").val("");
                $("#selectSort").val("");
                $("#priceAll").prop("checked", true);
                loadProducts(1);
            });

            // Thêm vào giỏ hàng bằng AJAX
            $("body").on("click", ".btn-add-cart", function (e) {
                e.preventDefault();
                var productId = $(this).data("id");
                $.ajax({
                    url: "/Cart/AddToCart",
                    type: "POST",
                    data: { id: productId, quantity: 1 },
                    success: function (res) {
                        if (res.success) {
                            $("#cartCountBadge").text(res.totalCount);
                            $("#toastMessage").html('<i class="bi bi-check-circle-fill me-2"></i>' + res.message);
                            var toast = new bootstrap.Toast($('#cartToast'));
                            toast.show();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });
        });
    </script>
}
