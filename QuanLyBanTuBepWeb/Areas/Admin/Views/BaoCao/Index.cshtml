@{
    ViewData["Title"] = "Trung Tâm Báo Cáo & Thống Kê";
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line text-primary me-2"></i>Hệ Thống Báo Cáo & Thống Kê</h5>
        <span class="badge bg-light text-secondary border">Dữ liệu trích xuất trực tiếp từ SQL Server</span>
    </div>

    <!-- Số liệu tổng hợp nhanh từ CSDL -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="p-3 border rounded bg-light">
                <div class="small text-muted">Tổng hoá đơn bán</div>
                <div class="fs-5 fw-bold text-primary">@ViewBag.TongHDBan đơn</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 border rounded bg-light">
                <div class="small text-muted">Tổng doanh thu bán</div>
                <div class="fs-5 fw-bold text-danger">@(((decimal)(ViewBag.TongDoanhThuBan ?? 0m)).ToString("N0")) đ</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 border rounded bg-light">
                <div class="small text-muted">Tổng hoá đơn nhập</div>
                <div class="fs-5 fw-bold text-info">@ViewBag.TongHDNhap đơn</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-3 border rounded bg-light">
                <div class="small text-muted">Tổng giá trị nhập kho</div>
                <div class="fs-5 fw-bold text-success">@(((decimal)(ViewBag.TongTienNhap ?? 0m)).ToString("N0")) đ</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-warning me-3"><i class="bi bi-trophy-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Top 3 Sản Phẩm Bán Chạy Nhất Theo Quý</h6>
                        <small class="text-muted">Thống kê sản lượng và doanh thu theo quý</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo danh sách 3 sản phẩm tủ bếp bán được nhiều nhất trong một quý chọn trước, kèm theo tổng số lượng và doanh thu.</p>
                <a asp-action="Top3SanPhamTheoQuy" class="btn btn-outline-warning btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-danger me-3"><i class="bi bi-arrow-down-circle-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Top 5 Hoá Đơn Bán Hàng Nhỏ Nhất Theo Quý</h6>
                        <small class="text-muted">Phân tích phân khúc đơn hàng giá trị nhỏ</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo chi tiết danh sách 5 hoá đơn có tổng tiền bán hàng nhỏ nhất theo quý chọn trước nhằm khảo sát phân khúc khách hàng lẻ.</p>
                <a asp-action="Top5HoaDonNhoNhatTheoQuy" class="btn btn-outline-danger btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-info me-3"><i class="bi bi-box-arrow-in-down"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Hóa Đơn Nhập Hàng Theo Nhân Viên</h6>
                        <small class="text-muted">Báo cáo lịch sử nhập kho theo nhân sự phụ trách</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo chi tiết danh sách các hóa đơn nhập do một nhân viên nhập được chọn trước, kèm chi tiết mặt hàng, đơn giá và nhà cung cấp.</p>
                <a asp-action="HoaDonNhapTheoNV" class="btn btn-outline-info btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border p-3 rounded-3 hover-shadow">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-success me-3"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Danh Sách Khách Hàng Mua Hàng Theo Tháng</h6>
                        <small class="text-muted">Thống kê tần suất và doanh số khách hàng theo tháng</small>
                    </div>
                </div>
                <p class="small text-muted flex-grow-1">Báo cáo thống kê toàn bộ khách hàng đã phát sinh giao dịch mua hàng trong một tháng chọn trước, kèm số lượt mua và tổng tiền.</p>
                <a asp-action="KhachHangTheoThang" class="btn btn-outline-success btn-sm fw-bold">
                    Xem báo cáo <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
