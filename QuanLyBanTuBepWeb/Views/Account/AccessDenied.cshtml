@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 rounded-4 max-w-xl mx-auto bg-white" style="max-width: 500px;">
        <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
        <h3 class="fw-bold text-dark">Truy Cập Bị Từ Chối</h3>
        <p class="text-muted small">Tài khoản của bạn không có đủ thẩm quyền truy cập vào phân vùng này. Chức năng này chỉ dành cho Quản trị viên hệ thống.</p>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                Quay về Trang chủ
            </a>
        </div>
    </div>
</div>
