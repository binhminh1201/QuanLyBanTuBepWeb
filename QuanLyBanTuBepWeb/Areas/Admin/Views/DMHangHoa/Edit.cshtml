@model QuanLyBanTuBepWeb.Models.DMHangHoa
@{
    ViewData["Title"] = "Chỉnh Sửa Tủ Bếp: " + Model.MaHang;
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Thông Tin Tủ Bếp (@Model.MaHang)</h5>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaHang" />
        <input type="hidden" asp-for="Anh" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="MaHang" class="form-label small fw-bold"></label>
                <input asp-for="MaHang" class="form-control form-control-sm bg-light" readonly />
            </div>

            <div class="col-md-8">
                <label asp-for="TenHang" class="form-label small fw-bold"></label>
                <input asp-for="TenHang" class="form-control form-control-sm" />
                <span asp-validation-for="TenHang" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="MaChatLieu" class="form-label small fw-bold"></label>
                <select asp-for="MaChatLieu" asp-items="ViewBag.MaChatLieu" class="form-select form-select-sm"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="MaMau" class="form-label small fw-bold"></label>
                <select asp-for="MaMau" asp-items="ViewBag.MaMau" class="form-select form-select-sm"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="MaKichThuoc" class="form-label small fw-bold"></label>
                <select asp-for="MaKichThuoc" asp-items="ViewBag.MaKichThuoc" class="form-select form-select-sm"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="MaNuocSX" class="form-label small fw-bold"></label>
                <select asp-for="MaNuocSX" asp-items="ViewBag.MaNuocSX" class="form-select form-select-sm"></select>
            </div>

            <div class="col-md-3">
                <label asp-for="SoLuong" class="form-label small fw-bold"></label>
                <input asp-for="SoLuong" class="form-control form-control-sm" type="number" min="0" />
                <span asp-validation-for="SoLuong" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="GiaNhap" class="form-label small fw-bold"></label>
                <input asp-for="GiaNhap" id="inputGiaNhap" class="form-control form-control-sm" type="number" step="100000" />
                <span asp-validation-for="GiaNhap" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DonGiaBan" class="form-label small fw-bold"></label>
                <input asp-for="DonGiaBan" id="inputDonGiaBan" class="form-control form-control-sm" type="number" step="100000" />
                <small class="text-muted" style="font-size: 0.7rem;">(110% giá nhập)</small>
                <span asp-validation-for="DonGiaBan" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="ThoiGianBaoHanh" class="form-label small fw-bold"></label>
                <input asp-for="ThoiGianBaoHanh" class="form-control form-control-sm" />
            </div>

            <div class="col-md-12">
                <label class="form-label small fw-bold">Hình ảnh hiện tại:</label>
                <div class="mb-2">
                    <img src="/images/products/@(string.IsNullOrEmpty(Model.Anh) ? "no_image.png" : Model.Anh)" class="rounded-3 border" style="width: 100px; height: 75px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                </div>
                <label asp-for="UploadAnh" class="form-label small fw-bold">Thay đổi hình ảnh mới (Nếu có):</label>
                <input asp-for="UploadAnh" class="form-control form-control-sm" type="file" accept="image/*" />
            </div>

            <div class="col-12">
                <label asp-for="GhiChu" class="form-label small fw-bold"></label>
                <textarea asp-for="GhiChu" id="editorGhiChu" class="form-control" rows="4"></textarea>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold">
                <i class="bi bi-check2-circle me-1"></i> Cập Nhật Thay Đổi
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('editorGhiChu');

        $("#inputGiaNhap").on("input", function () {
            var giaNhap = parseFloat($(this).val()) || 0;
            if (giaNhap > 0) {
                var giaBan = Math.round(giaNhap * 1.10);
                $("#inputDonGiaBan").val(giaBan);
            }
        });
    </script>
}
