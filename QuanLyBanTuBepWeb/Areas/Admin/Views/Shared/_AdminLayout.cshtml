<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống Tủ Bếp</title>
    <!-- Bootstrap 5 CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --sidebar-active: #0ea5e9;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f1f5f9;
        }
        #sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: var(--sidebar-bg);
            color: #94a3b8;
            transition: all 0.3s;
        }
        #sidebar .nav-link {
            color: #cbd5e1;
            padding: 12px 20px;
            font-weight: 500;
            display: flex;
            align-items: center;
            border-radius: 8px;
            margin: 4px 12px;
        }
        #sidebar .nav-link:hover {
            background-color: var(--sidebar-hover);
            color: #ffffff;
        }
        #sidebar .nav-link.active {
            background-color: var(--sidebar-active);
            color: #ffffff;
            font-weight: 600;
        }
        #content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .admin-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
        }
        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
    </style>
</head>
<body class="d-flex">
    <!-- Sidebar Navigation -->
    <div id="sidebar" class="d-flex flex-column p-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-4 text-white text-decoration-none px-2">
            <i class="bi bi-shield-lock-fill fs-3 text-info me-2"></i>
            <div>
                <div class="fw-bold fs-5 lh-1">ADMIN PANEL</div>
                <small class="text-muted" style="font-size: 0.75rem;">Quản Lý Bán Tủ Bếp</small>
            </div>
        </a>

        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2 fs-5"></i> Bảng điều khiển
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="DMHangHoa" asp-action="Index">
                    <i class="bi bi-box-seam me-2 fs-5"></i> Quản lý Tủ Bếp
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="HoaDonBan" asp-action="Index">
                    <i class="bi bi-receipt-cutoff me-2 fs-5"></i> Hoá đơn bán hàng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="BaoCao" asp-action="Index">
                    <i class="bi bi-bar-chart-line me-2 fs-5"></i> Báo cáo & Thống kê
                </a>
            </li>
            <li class="my-3 border-top border-secondary"></li>
            <li class="nav-item">
                <a class="nav-link text-warning" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-shop me-2 fs-5"></i> Xem trang Khách hàng
                </a>
            </li>
        </ul>

        <div class="border-top border-secondary pt-3 px-2">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-circle fs-3 text-info me-2"></i>
                    <div>
                        <div class="text-white small fw-bold">@User.Identity?.Name</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Quản trị viên</div>
                    </div>
                </div>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="text-danger" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div id="content-wrapper">
        <!-- Topbar -->
        <div class="admin-topbar d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 text-dark fw-bold">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                    <i class="bi bi-database-check me-1"></i> SQL Server 2022: Connected
                </span>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Ra Web Bán Hàng
                </a>
            </div>
        </div>

        <!-- Body Content -->
        <div class="container-fluid p-4">
            <!-- Flash Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>

        <footer class="mt-auto py-3 bg-white border-top text-center text-muted small">
            Quản Trị Hệ Thống Tủ Bếp &copy; @DateTime.Now.Year - Nhóm 5 (Lập trình trực quan & Web ASP.NET Core)
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
