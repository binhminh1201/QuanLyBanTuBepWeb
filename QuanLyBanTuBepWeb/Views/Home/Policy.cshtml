@{
    ViewData["Title"] = "Chính Sách & Hỗ Trợ Khách Hàng - KITCHENLUX";
    string activeTab = ViewBag.ActiveTab as string ?? "bao-hanh";
    // Đảm bảo activeTab chuẩn
    if (activeTab != "bao-hanh" && activeTab != "khao-sat" && activeTab != "thanh-toan" && activeTab != "bao-mat")
    {
        activeTab = "bao-hanh";
    }
}

<style>
    /* Custom Styling for Policy Page */
    .policy-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        color: #ffffff;
        position: relative;
        overflow: hidden;
    }
    .policy-hero::after {
        content: "";
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    
    .policy-sidebar-btn {
        transition: all 0.25s ease;
        border: 1px solid transparent !important;
        background-color: #ffffff;
        color: #334155;
        text-align: left;
    }
    .policy-sidebar-btn:hover {
        background-color: #f8fafc;
        border-color: #e2e8f0 !important;
        transform: translateX(4px);
    }
    .policy-sidebar-btn.active {
        background: #f0fdf4 !important;
        border-color: #bbf7d0 !important;
        border-left: 4px solid #16a34a !important;
        color: #14532d !important;
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.08);
    }
    .policy-sidebar-btn.active[data-tab="bao-hanh"] {
        background: #fef2f2 !important;
        border-color: #fecaca !important;
        border-left: 4px solid #dc2626 !important;
        color: #7f1d1d !important;
    }
    .policy-sidebar-btn.active[data-tab="khao-sat"] {
        background: #f0fdf4 !important;
        border-color: #bbf7d0 !important;
        border-left: 4px solid #16a34a !important;
        color: #14532d !important;
    }
    .policy-sidebar-btn.active[data-tab="thanh-toan"] {
        background: #fffbeb !important;
        border-color: #fde68a !important;
        border-left: 4px solid #d97706 !important;
        color: #78350f !important;
    }
    .policy-sidebar-btn.active[data-tab="bao-mat"] {
        background: #eff6ff !important;
        border-color: #bfdbfe !important;
        border-left: 4px solid #2563eb !important;
        color: #1e3a8a !important;
    }

    .icon-badge {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .timeline-step {
        position: relative;
        padding-left: 54px;
        margin-bottom: 28px;
    }
    .timeline-step:last-child {
        margin-bottom: 0;
    }
    .timeline-step::before {
        content: "";
        position: absolute;
        left: 20px;
        top: 36px;
        bottom: -28px;
        width: 2px;
        background: #e2e8f0;
    }
    .timeline-step:last-child::before {
        display: none;
    }
    .timeline-badge {
        position: absolute;
        left: 0;
        top: 0;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }

    .feature-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .feature-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border-color: #cbd5e1;
    }
</style>

<!-- Hero Section Banner -->
<section class="policy-hero py-5 mb-5 shadow-sm">
    <div class="container py-2 position-relative" style="z-index: 2;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-3 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item text-white active fw-semibold" aria-current="page">Chính sách & Dịch vụ</li>
            </ol>
        </nav>
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <i class="bi bi-patch-check-fill me-1"></i> KitchenLux Customer Care
                </span>
                <h1 class="display-6 fw-bold mb-2">Chính Sách & Hỗ Trợ Khách Hàng</h1>
                <p class="text-white-50 mb-0 fs-6">
                    Mọi cam kết về chất lượng, chế độ bảo hành 24-36 tháng, quy trình khảo sát tận nơi và bảo vệ dữ liệu khách hàng minh bạch 100%.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-flex align-items-center gap-3 bg-white bg-opacity-10 px-4 py-3 rounded-4 backdrop-blur border border-white border-opacity-20">
                    <i class="bi bi-headset fs-1 text-warning"></i>
                    <div class="text-start">
                        <small class="text-white-50 d-block">Hotline Hỗ Trợ Kỹ Thuật</small>
                        <a href="tel:0345228952" class="text-white fw-bold text-decoration-none fs-5">0345.228.952</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Container -->
<div class="container pb-5">
    <div class="row g-4">
        <!-- Sidebar Navigation Pills -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 sticky-top overflow-hidden" style="top: 90px; z-index: 10;">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <span class="text-muted text-uppercase fw-bold small" style="letter-spacing: 0.5px;">
                        <i class="bi bi-list-nested me-2 text-primary"></i>Danh mục dịch vụ
                    </span>
                </div>
                <div class="card-body p-3 bg-light bg-opacity-50">
                    <div class="nav flex-column nav-pills gap-2" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        
                        <!-- Tab 1: Bảo hành -->
                        <button class="nav-link policy-sidebar-btn p-3 rounded-3 d-flex align-items-center gap-3 @(activeTab == "bao-hanh" ? "active" : "")" 
                                id="tab-bao-hanh" data-tab="bao-hanh" data-bs-toggle="pill" data-bs-target="#content-bao-hanh" type="button" role="tab">
                            <div class="icon-badge bg-danger-subtle text-danger">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Chính sách bảo hành</div>
                                <div class="small text-muted">Bảo hành kết cấu 24 - 36 tháng</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small opacity-50"></i>
                        </button>

                        <!-- Tab 2: Khảo sát -->
                        <button class="nav-link policy-sidebar-btn p-3 rounded-3 d-flex align-items-center gap-3 @(activeTab == "khao-sat" ? "active" : "")" 
                                id="tab-khao-sat" data-tab="khao-sat" data-bs-toggle="pill" data-bs-target="#content-khao-sat" type="button" role="tab">
                            <div class="icon-badge bg-success-subtle text-success">
                                <i class="bi bi-tools"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Khảo sát & Lắp đặt</div>
                                <div class="small text-muted">Đo laser & dựng 3D miễn phí</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small opacity-50"></i>
                        </button>

                        <!-- Tab 3: Thanh toán & Vận chuyển -->
                        <button class="nav-link policy-sidebar-btn p-3 rounded-3 d-flex align-items-center gap-3 @(activeTab == "thanh-toan" ? "active" : "")" 
                                id="tab-thanh-toan" data-tab="thanh-toan" data-bs-toggle="pill" data-bs-target="#content-thanh-toan" type="button" role="tab">
                            <div class="icon-badge bg-warning-subtle text-warning">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Thanh toán & Giao hàng</div>
                                <div class="small text-muted">Miễn phí 25km, COD & QR</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small opacity-50"></i>
                        </button>

                        <!-- Tab 4: Bảo mật -->
                        <button class="nav-link policy-sidebar-btn p-3 rounded-3 d-flex align-items-center gap-3 @(activeTab == "bao-mat" ? "active" : "")" 
                                id="tab-bao-mat" data-tab="bao-mat" data-bs-toggle="pill" data-bs-target="#content-bao-mat" type="button" role="tab">
                            <div class="icon-badge bg-primary-subtle text-primary">
                                <i class="bi bi-lock-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Bảo mật thông tin</div>
                                <div class="small text-muted">Bảo vệ quyền riêng tư 100%</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small opacity-50"></i>
                        </button>
                    </div>

                    <!-- Tư vấn nhanh Card -->
                    <div class="mt-4 p-3 bg-white rounded-3 border text-center shadow-xs">
                        <div class="text-danger mb-2"><i class="bi bi-clock-history fs-3"></i></div>
                        <h6 class="fw-bold mb-1">Thời gian làm việc</h6>
                        <p class="small text-muted mb-2">Thứ 2 - Chủ Nhật: <strong>8h00 - 21h30</strong></p>
                        <a href="https://zalo.me/0345228952" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                            <i class="bi bi-chat-dots me-1"></i> Nhắn tin tư vấn Zalo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="tab-content" id="v-pills-tabContent">
                    
                    <!-- ============================================== -->
                    <!-- TAB 1: CHÍNH SÁCH BẢO HÀNH                      -->
                    <!-- ============================================== -->
                    <div class="tab-pane fade @(activeTab == "bao-hanh" ? "show active" : "")" id="content-bao-hanh" role="tabpanel">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="icon-badge bg-danger text-white shadow-sm" style="width: 50px; height: 50px; border-radius: 14px;">
                                <i class="bi bi-shield-check fs-3"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-1">Chính Sách Bảo Hành & Bảo Trì</h3>
                                <p class="text-muted small mb-0">Cam kết bảo hành chính hãng uy tín cho toàn bộ hệ thống tủ bếp KITCHENLUX</p>
                            </div>
                        </div>

                        <!-- 3 Cards Highlight Thời Hạn -->
                        <h5 class="fw-bold text-dark mt-4 mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">1</span>
                            Thời Hạn Bảo Hành Theo Nhóm Vật Liệu
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="feature-box h-100 border-danger border-opacity-25 bg-danger bg-opacity-10">
                                    <span class="badge bg-danger mb-2">36 Tháng (3 Năm)</span>
                                    <h6 class="fw-bold text-danger mb-1">Tủ Bếp Inox Cánh Kính</h6>
                                    <p class="small text-muted mb-0">Chống rỉ sét khung inox 304, chống cong vênh nứt vỡ kính cường lực.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box h-100 border-primary border-opacity-25 bg-primary bg-opacity-10">
                                    <span class="badge bg-primary mb-2">24 Tháng (2 Năm)</span>
                                    <h6 class="fw-bold text-primary mb-1">Gỗ MDF & Nhựa Picomat</h6>
                                    <p class="small text-muted mb-0">Bảo hành cốt gỗ An Cường chống ẩm, không bong tróc cạnh nẹp dán.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box h-100 border-warning border-opacity-25 bg-warning bg-opacity-10">
                                    <span class="badge bg-warning text-dark mb-2">12 - 24 Tháng</span>
                                    <h6 class="fw-bold text-dark mb-1">Phụ Kiện Bản Lề & Ray</h6>
                                    <p class="small text-muted mb-0">1 đổi 1 nếu hỏng piston thủy lực, kẹt rãnh ray của Blum, Hafele, Eurogold.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Điều Kiện Bảo Hành -->
                        <h5 class="fw-bold text-dark mt-4 mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">2</span>
                            Điều Kiện Bảo Hành Miễn Phí
                        </h5>
                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <ul class="list-unstyled d-flex flex-column gap-2 small text-secondary mb-0">
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                                    <span>Sản phẩm còn trong thời hạn bảo hành tính từ ngày ký biên bản nghiệm thu hoặc lưu trữ trên hệ thống điện tử.</span>
                                </li>
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                                    <span>Hư hỏng kỹ thuật do quá trình sản xuất dán cạnh ép nhiệt, lỗi ray trượt hoặc do nhân viên thi công lắp đặt.</span>
                                </li>
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                                    <span>Khách hàng cung cấp đúng Số điện thoại hoặc Mã đơn hàng đã lưu trong hệ thống quản lý.</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Quy trình bảo hành 3 bước -->
                        <h5 class="fw-bold text-dark mt-4 mb-3 d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-circle p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">3</span>
                            Quy Trình Xử Lý Sự Cố Trong 24h - 48h
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="feature-box h-100 text-center">
                                    <div class="icon-badge bg-light text-primary mx-auto mb-2">1</div>
                                    <h6 class="fw-bold">Tiếp nhận lỗi</h6>
                                    <p class="small text-muted mb-0">Khách gửi hình ảnh sự cố qua Zalo hoặc Hotline <strong>0345.228.952</strong>.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box h-100 text-center">
                                    <div class="icon-badge bg-light text-success mx-auto mb-2">2</div>
                                    <h6 class="fw-bold">Có mặt tận nhà</h6>
                                    <p class="small text-muted mb-0">Kỹ thuật viên đến khảo sát và xác định nguyên nhân trong vòng 24 - 48 giờ.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box h-100 text-center">
                                    <div class="icon-badge bg-light text-danger mx-auto mb-2">3</div>
                                    <h6 class="fw-bold">Sửa chữa / Đổi mới</h6>
                                    <p class="small text-muted mb-0">Thay thế linh kiện chính hãng mới 100% hoàn toàn không phát sinh chi phí.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- TAB 2: QUY TRÌNH KHẢO SÁT & LẮP ĐẶT             -->
                    <!-- ============================================== -->
                    <div class="tab-pane fade @(activeTab == "khao-sat" ? "show active" : "")" id="content-khao-sat" role="tabpanel">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="icon-badge bg-success text-white shadow-sm" style="width: 50px; height: 50px; border-radius: 14px;">
                                <i class="bi bi-tools fs-3"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-1">Quy Trình Khảo Sát & Lắp Đặt Tận Nơi</h3>
                                <p class="text-muted small mb-0">Quy chuẩn 5 bước chuyên nghiệp từ khâu ý tưởng đến khi căn bếp hoàn thiện</p>
                            </div>
                        </div>

                        <div class="timeline mt-4">
                            <!-- Bước 1 -->
                            <div class="timeline-step">
                                <div class="timeline-badge bg-primary text-white">1</div>
                                <div class="feature-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-primary mb-0">Tiếp nhận nhu cầu & Báo giá dự toán</h6>
                                        <span class="badge bg-light text-muted border small">Bước 1</span>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Lắng nghe ý tưởng, diện tích bếp dự kiến, phong cách thiết kế ưa thích (Acrylic bóng gương, Inox sang trọng hay Gỗ tự nhiên). Cung cấp bảng dự toán chi phí minh bạch.
                                    </p>
                                </div>
                            </div>

                            <!-- Bước 2 -->
                            <div class="timeline-step">
                                <div class="timeline-badge bg-success text-white">2</div>
                                <div class="feature-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-success mb-0">Khảo sát đo đạc laser tận nơi miễn phí</h6>
                                        <span class="badge bg-light text-muted border small">Bước 2</span>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Kiến trúc sư mang mẫu vật liệu thực tế đến tận nhà khách hàng: đo chính xác bằng thước đo laser, khảo sát hướng cấp thoát nước, đường dây điện và ổ cắm bếp từ.
                                    </p>
                                </div>
                            </div>

                            <!-- Bước 3 -->
                            <div class="timeline-step">
                                <div class="timeline-badge bg-warning text-dark">3</div>
                                <div class="feature-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-dark mb-0">Lên phối cảnh trực quan 3D & Bản vẽ kỹ thuật 2D</h6>
                                        <span class="badge bg-light text-muted border small">Bước 3</span>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Dựng bản vẽ phối cảnh 3D trực quan giúp khách hàng hình dung rõ tủ bếp thực tế sau khi lắp đặt. Bố trí chuẩn tam giác bếp nấu - bồn rửa - tủ lạnh hợp phong thủy.
                                    </p>
                                </div>
                            </div>

                            <!-- Bước 4 -->
                            <div class="timeline-step">
                                <div class="timeline-badge bg-danger text-white">4</div>
                                <div class="feature-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-danger mb-0">Sản xuất gia công tại xưởng máy CNC hiện đại</h6>
                                        <span class="badge bg-light text-muted border small">Bước 4</span>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Gia công chính xác trên máy cắt tự động, dán nẹp cạnh nhiệt chống ngấm nước. Thời gian hoàn thiện sản xuất từ 5 - 10 ngày làm việc.
                                    </p>
                                </div>
                            </div>

                            <!-- Bước 5 -->
                            <div class="timeline-step">
                                <div class="timeline-badge bg-info text-white">5</div>
                                <div class="feature-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-info mb-0">Vận chuyển, Thi công lắp ráp & Bàn giao nghiệm thu</h6>
                                        <span class="badge bg-light text-muted border small">Bước 5</span>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Đội ngũ kỹ thuật viên lắp ráp trọn gói trong ngày, dọn dẹp vệ sinh sạch sẽ, nghiệm thu thực tế và bàn giao kích hoạt tem bảo hành.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- TAB 3: THANH TOÁN & VẬN CHUYỂN                  -->
                    <!-- ============================================== -->
                    <div class="tab-pane fade @(activeTab == "thanh-toan" ? "show active" : "")" id="content-thanh-toan" role="tabpanel">
