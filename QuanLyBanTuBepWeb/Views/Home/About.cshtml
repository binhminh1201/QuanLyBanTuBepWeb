@{
    ViewData["Title"] = "Giới Thiệu Về KITCHENLUX";
}

<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giới thiệu</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="text-primary fw-bold text-uppercase small">Về thương hiệu chúng tôi</span>
            <h2 class="fw-bold display-6 mb-3">Chuyên Gia Thiết Kế & Sản Xuất Tủ Bếp Hàng Đầu</h2>
            <p class="text-muted leading-relaxed">
                Với hơn 10 năm kinh nghiệm trong lĩnh vực nội thất phòng bếp, KITCHENLUX tự hào mang đến cho hàng nghìn gia đình Việt những không gian nấu nướng tiện nghi, sang trọng và chuẩn phong thủy.
            </p>
            <p class="text-muted leading-relaxed">
                Chúng tôi sở hữu nhà máy sản xuất quy mô với hệ thống máy móc dán cạnh tự động, cắt CNC chính xác tuyệt đối, nhập khẩu nguyên liệu 100% từ các thương hiệu uy tín hàng đầu như gỗ An Cường, nhựa Picomat, phụ kiện Hafele, Blum.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 text-center">
                        <h3 class="fw-bold text-primary mb-1">5,000+</h3>
                        <span class="small text-muted">Căn bếp đã thi công</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 text-center">
                        <h3 class="fw-bold text-warning mb-1">99%</h3>
                        <span class="small text-muted">Khách hàng hài lòng</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <img src="~/images/products/tu_bep_02.svg" class="img-fluid rounded-4 shadow-sm" alt="Showroom Tủ Bếp">
        </div>
    </div>
</div>
