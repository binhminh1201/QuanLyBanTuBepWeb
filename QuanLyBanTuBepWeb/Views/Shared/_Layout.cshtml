@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var cart = session?.GetObjectFromJson<List<QuanLyBanTuBepWeb.Models.ViewModels.CartItem>>("KITCHEN_CART_SESSION");
    int cartCount = cart?.Sum(c => c.SoLuong) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Showroom Tủ Bếp Cao Cấp</title>
    <!-- Bootstrap 5 CDN (Đảm bảo 100% tải được CSS kể cả khi chạy localhost) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #1e3a8a;
            --accent-color: #d97706;
            --dark-color: #0f172a;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #334155;
            background-color: #f8fafc;
        }
        .navbar-brand {
            font-weight: 800;
            color: var(--primary-color) !important;
            letter-spacing: 0.5px;
        }
        .navbar-brand span {
            color: var(--accent-color);
        }
        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            transition: color 0.2s;
        }
        .nav-link:hover, .nav-link.active {
            color: var(--primary-color) !important;
        }
        .footer {
            background-color: var(--dark-color);
            color: #94a3b8;
        }
        .footer a {
            color: #cbd5e1;
            text-decoration: none;
        }
        .footer a:hover {
            color: #ffffff;
        }
        .card-product {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
            overflow: hidden;
            background: #ffffff;
        }
        .card-product:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        .product-img {
            height: 220px;
            min-height: 220px;
            max-height: 220px;
            object-fit: cover;
            width: 100%;
            background-color: #f1f5f9;
            display: block;
        }
        .btn-primary-custom {
            background-color: var(--primary-color);
            color: white;
            border: none;
        }
        .btn-primary-custom:hover {
            background-color: #172554;
            color: white;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Contact Bar -->
    <div class="bg-light py-2 border-bottom d-none d-md-block small text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Số 54, Phố Nội Thất, Hà Nội |
                <i class="bi bi-telephone-fill text-success ms-2 me-1"></i> Hotline: 0912.345.678
            </div>
            <div>
                <i class="bi bi-shield-check text-primary me-1"></i> Bảo hành chính hãng lên đến 36 tháng
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <header class="sticky-top bg-white shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill me-2"></i>KITCHEN<span>LUX</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Bộ sưu tập Tủ Bếp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ & Báo giá</a>
                        </li>
                    </ul>

                    <!-- Search Quick Form -->
                    <form class="d-flex me-3" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control form-control-sm" type="search" name="keyword" placeholder="Tìm tủ bếp theo tên, mã..." aria-label="Search">
                            <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <!-- User and Cart Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Giỏ hàng -->
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary position-relative btn-sm px-3">
                            <i class="bi bi-cart3 fs-6"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartCountBadge">
                                @cartCount
                            </span>
                        </a>

                        <!-- Tài khoản -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-1 border" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle text-primary fs-5"></i>
                                    <span class="fw-semibold">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item text-danger fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Trang Quản Trị</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Orders"><i class="bi bi-receipt me-2"></i>Đơn hàng của tôi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-sm">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Flash Messages (TempData) -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Page Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-grid-1x2-fill me-2"></i>KITCHENLUX</h5>
                    <p class="small">Chuyên tư vấn, thiết kế và thi công hệ thống tủ bếp hiện đại hàng đầu Việt Nam. Chất lượng vượt trội, mẫu mã đa dạng theo phong cách Châu Âu và Bắc Âu.</p>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-2"></i>Hà Nội, Việt Nam</p>
                    <p class="small mb-1"><i class="bi bi-envelope me-2"></i>contact@tubepkitchenlux.vn</p>
                    <p class="small"><i class="bi bi-telephone me-2"></i>0912.345.678</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Danh mục chính</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Product" asp-action="Index" asp-route-maChatLieu="CL02">Tủ bếp Acrylic</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-maChatLieu="CL03">Tủ bếp Inox cánh kính</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-maChatLieu="CL04">Tủ bếp Gỗ Tự Nhiên</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-maChatLieu="CL01">Tủ bếp MDF lõi xanh</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-maChatLieu="CL05">Tủ bếp nhựa Picomat</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Chính sách & Hỗ trợ</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#">Chính sách bảo hành 24-36 tháng</a></li>
                        <li><a href="#">Quy trình khảo sát & Lắp đặt tận nơi</a></li>
                        <li><a href="#">Chính sách bảo mật thông tin</a></li>
                        <li><a href="#">Hướng dẫn thanh toán & Vận chuyển</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Bài tập lớn Lập Trình Web</h6>
                    <p class="small">Đề tài: Quản lý bán tủ bếp (ASP.NET Core MVC 10 + EF Core + SQL Server 2022).</p>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-shield-lock me-1"></i> Đăng nhập Quản trị (Admin)
                        </a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small">
                &copy; @DateTime.Now.Year KITCHENLUX - Bài tập lớn Lập trình Web - Nhóm 5. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- jQuery and Bootstrap 5 Bundle CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Toast & Cart Notification Helper -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="cartToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                    <i class="bi bi-check-circle-fill me-2"></i>Đã thêm vào giỏ hàng!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
