@model IEnumerable<QuanLyBanTuBepWeb.Models.ViewModels.HoaDonNhapTheoNVItemVM>
@{
    ViewData["Title"] = "Báo Cáo Hóa Đơn Nhập Theo Nhân Viên";
    var nhanViens = ViewBag.NhanViens as IEnumerable<QuanLyBanTuBepWeb.Models.NhanVien>;
    string selectedNV = ViewBag.SelectedNV as string ?? "";
    var currentNV = nhanViens?.FirstOrDefault(nv => nv.MaNV == selectedNV);
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold text-dark mb-1">
                <i class="bi bi-box-arrow-in-down text-info me-2"></i>Báo Cáo Chi Tiết Hóa Đơn Nhập Hàng Theo Nhân Viên
            </h5>
            <small class="text-muted">(Yêu cầu số 7 trong file đề bài Excel)</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Filter form chọn nhân viên -->
    <form asp-action="HoaDonNhapTheoNV" method="get" class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded-3">
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted fw-bold mb-0">Chọn nhân viên nhập:</label>
            <select name="maNV" class="form-select form-select-sm" style="min-width: 250px;">
                @if (nhanViens != null)
                {
                    foreach (var nv in nhanViens)
                    {
                        <option value="@nv.MaNV" selected="@(nv.MaNV == selectedNV ? "selected" : null)">
                            @nv.MaNV - @nv.TenNV (@(nv.DienThoai ?? "NV"))
                        </option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-funnel-fill me-1"></i>Xem báo cáo
        </button>
    </form>

    @if (currentNV != null)
    {
        <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center mb-3">
            <div>
                <strong>Nhân viên:</strong> @currentNV.TenNV (@currentNV.MaNV) | 
                <strong>SĐT:</strong> @(currentNV.DienThoai ?? "-") | 
                <strong>Địa chỉ:</strong> @(currentNV.DiaChi ?? "-")
            </div>
            <div>
                <strong>Tổng số dòng chi tiết:</strong> <span class="badge bg-primary">@(Model?.Count() ?? 0)</span>
            </div>
        </div>
    }

    <!-- Bảng chi tiết hóa đơn nhập -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Số HDN</th>
                    <th>Ngày nhập</th>
                    <th>Nhà cung cấp</th>
                    <th>Mã hàng</th>
                    <th>Tên tủ bếp</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá nhập</th>
                    <th class="text-center">Giảm giá</th>
                    <th class="text-end">Thành tiền</th>
                    <th class="text-end">Tổng tiền HĐN</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.SoHDN</td>
                            <td>@(item.NgayNhap.HasValue ? item.NgayNhap.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td><span class="badge bg-light text-dark border">@(item.TenNCC ?? "-")</span></td>
                            <td class="fw-bold">@item.MaHang</td>
                            <td class="fw-semibold">@item.TenHang</td>
                            <td class="text-center fw-bold">@item.SoLuong</td>
                            <td class="text-end">@item.DonGia.ToString("N0") đ</td>
                            <td class="text-center">@(item.GiamGia > 0 ? $"{item.GiamGia}%" : "-")</td>
                            <td class="text-end fw-bold text-success">@item.ThanhTien.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-danger">@item.TongTienHoaDon.ToString("N0") đ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có hóa đơn nhập hàng nào cho nhân viên này!
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model != null && Model.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="5" class="text-end">TỔNG CỘNG:</td>
                        <td class="text-center text-primary">@Model.Sum(x => x.SoLuong)</td>
                        <td colspan="2"></td>
                        <td class="text-end text-success">@Model.Sum(x => x.ThanhTien).ToString("N0") đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
