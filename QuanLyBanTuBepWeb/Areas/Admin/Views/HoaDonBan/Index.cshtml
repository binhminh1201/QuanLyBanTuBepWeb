@model IEnumerable<QuanLyBanTuBepWeb.Models.HoaDonBan>
@{
    ViewData["Title"] = "Quản Lý Hoá Đơn Bán Hàng";
    var hangHoas = ViewBag.HangHoas as IEnumerable<QuanLyBanTuBepWeb.Models.DMHangHoa>;
    string selectedMaHang = ViewBag.MaHang as string ?? "";
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-1"><i class="bi bi-receipt text-primary me-2"></i>Quản Lý Hoá Đơn Bán Hàng</h5>
            <small class="text-muted">(Hỗ trợ tìm kiếm theo Mã hàng, Ngày bán, Khoảng tổng tiền - Yêu cầu số 5)</small>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2">Tổng số: <strong>@Model.Count()</strong> hoá đơn</span>
        </div>
    </div>

    <!-- Filter Form: YC 5 (Mã hàng, Ngày bán, Tổng tiền) -->
    <form asp-action="Index" method="get" class="p-3 bg-light rounded-3 mb-4">
        <div class="row g-2 align-items-end">
            <!-- 1. Mã hàng hoá trong HĐ -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Mặt hàng trong HĐ:</label>
                <select name="maHang" class="form-select form-select-sm">
                    <option value="">-- Tất cả mặt hàng --</option>
                    @if (hangHoas != null)
                    {
                        foreach (var h in hangHoas)
                        {
                            <option value="@h.MaHang" selected="@(h.MaHang == selectedMaHang ? "selected" : null)">
                                @h.MaHang - @h.TenHang
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- 2. Ngày bán -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Từ ngày:</label>
                <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Đến ngày:</label>
                <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
            </div>

            <!-- 3. Khoảng tổng tiền -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Khoảng tổng tiền (VNĐ):</label>
                <div class="input-group input-group-sm">
                    <input type="number" name="tongTienTu" class="form-control" placeholder="Từ..." value="@ViewBag.TongTienTu" step="1000000" />
                    <span class="input-group-text">-</span>
                    <input type="number" name="tongTienDen" class="form-control" placeholder="Đến..." value="@ViewBag.TongTienDen" step="1000000" />
                </div>
            </div>

            <!-- Buttons -->
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Số HDB</th>
                    <th>Ngày bán</th>
                    <th>Khách hàng</th>
                    <th>Điện thoại</th>
                    <th>Địa chỉ lắp đặt</th>
                    <th>Nhân viên lập</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center" style="width: 80px;">Xem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.SoHDB</td>
                        <td>@item.NgayBan?.ToString("dd/MM/yyyy")</td>
                        <td class="fw-semibold">@(item.KhachHang?.TenKhach ?? "Khách lẻ")</td>
                        <td>@(item.KhachHang?.DienThoai ?? "-")</td>
                        <td>@(item.KhachHang?.DiaChi ?? "-")</td>
                        <td>@(item.NhanVien?.TenNV ?? "N/A")</td>
                        <td class="text-end fw-bold text-danger">@item.TongTien?.ToString("N0") đ</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.SoHDB" class="btn btn-outline-primary btn-sm" title="Xem chi tiết đơn">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
