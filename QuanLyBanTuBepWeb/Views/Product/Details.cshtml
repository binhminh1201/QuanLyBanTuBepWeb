@model QuanLyBanTuBepWeb.Models.DMHangHoa
@{
    ViewData["Title"] = Model.TenHang;
    var related = ViewBag.RelatedProducts as IEnumerable<QuanLyBanTuBepWeb.Models.DMHangHoa>;
}

<!-- Breadcrumb -->
<div class="bg-white border-bottom py-3 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Tủ Bếp</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.TenHang</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <!-- Product Image & Multi-Angle Gallery -->
            <div class="col-lg-6 p-4 bg-light d-flex flex-column justify-content-between">
                <!-- Main Image Display -->
                <div class="position-relative text-center d-flex align-items-center justify-content-center bg-white rounded-4 p-2 shadow-sm border" style="min-height: 380px; max-height: 440px; overflow: hidden;">
                    <img id="mainProductImg" src="/images/products/@Model.AnhChinh" class="img-fluid rounded-3" alt="@Model.TenHang" style="max-height: 400px; width: 100%; object-fit: contain; transition: all 0.25s ease;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                    <span id="imgAngleBadge" class="position-absolute top-0 start-0 m-3 badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill small fw-normal">
                        <i class="bi bi-camera me-1"></i> Góc chính diện
                    </span>
                </div>

                <!-- Multi-angle Thumbnails Gallery -->
                <div class="mt-3">
                    <div class="small fw-bold text-muted mb-2 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-images me-1 text-primary"></i> Hình ảnh các góc chụp thực tế:</span>
                        <span class="text-primary small" style="font-size: 0.75rem;">Nhấp vào ảnh để phóng to</span>
                    </div>
                    <div class="d-flex gap-2 overflow-auto py-1" id="productThumbnails">
                        @{
                            var labels = new[] { "Chính diện", "Góc nghiêng 3D", "Khoang & Phụ kiện", "Mặt đá & Bố trí" };
                            var imgIndex = 0;
                        }
                        @foreach (var imgName in Model.DanhSachAnh)
                        {
                            var lbl = imgIndex < labels.Length ? labels[imgIndex] : $"Góc chụp {imgIndex + 1}";
                            <div class="thumb-item text-center cursor-pointer @(imgIndex == 0 ? "active-thumb" : "")" style="cursor: pointer; min-width: 85px;" data-src="/images/products/@imgName" data-label="@lbl">
                                <div class="border rounded-3 p-1 bg-white shadow-xs position-relative" style="height: 65px; overflow: hidden; transition: all 0.2s;">
                                    <img src="/images/products/@imgName" class="w-100 h-100 rounded-2" style="object-fit: cover;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                                </div>
                                <small class="d-block text-truncate text-muted mt-1" style="font-size: 0.7rem; max-width: 85px;">@lbl</small>
                            </div>
                            imgIndex++;
                        }
                    </div>
                </div>
            </div>

            <!-- Product Specs and Buy Form -->
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">Mã: @Model.MaHang</span>
                        <span class="badge @(Model.SoLuong > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-1 rounded-pill">
                            @(Model.SoLuong > 0 ? $"Còn {Model.SoLuong} sản phẩm" : "Hết hàng")
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">@Model.TenHang</h2>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <small class="text-muted d-block mb-1">Giá bán niêm yết:</small>
                        <span class="display-6 fw-bold text-danger">@Model.DonGiaBan?.ToString("N0") đ</span>
                        <span class="text-muted small ms-2">(Đã bao gồm VAT và công lắp đặt cơ bản)</span>
                    </div>

                    <!-- Specification Table -->
                    <h6 class="fw-bold text-dark mb-3">Thông số kỹ thuật sản phẩm:</h6>
                    <table class="table table-bordered table-sm small mb-4">
                        <tbody>
                            <tr>
                                <th class="bg-light" style="width: 40%;">Chất liệu thùng & cánh:</th>
                                <td><strong>@(Model.ChatLieu?.TenChatLieu ?? "N/A")</strong></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Màu sắc chủ đạo:</th>
                                <td>@(Model.MauSac?.TenMau ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Kích thước chuẩn:</th>
                                <td>@(Model.KichThuoc?.TenKichThuoc ?? "Theo yêu cầu")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Nước sản xuất / Nhập khẩu:</th>
                                <td>@(Model.NuocSanXuat?.TenNuocSX ?? "Việt Nam")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Thời gian bảo hành:</th>
                                <td><span class="text-success fw-bold"><i class="bi bi-shield-check me-1"></i>@(Model.ThoiGianBaoHanh ?? "24 tháng")</span></td>
                            </tr>
                        </tbody>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">Mô tả đặc tính:</h6>
                            <p class="small text-muted mb-0">@Model.GhiChu</p>
                        </div>
                    }
                </div>

                <!-- Add to cart action -->
                <div class="pt-3 border-top">
                    @if (Model.SoLuong > 0)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="input-group" style="width: 130px;">
                                <button class="btn btn-outline-secondary" type="button" id="btnMinus"><i class="bi bi-dash"></i></button>
                                <input type="number" id="inputQuantity" class="form-control text-center" value="1" min="1" max="@Model.SoLuong">
                                <button class="btn btn-outline-secondary" type="button" id="btnPlus"><i class="bi bi-plus"></i></button>
                            </div>
                            <button id="btnAddToCart" class="btn btn-primary-custom btn-lg flex-grow-1 fw-bold shadow-sm" data-id="@Model.MaHang">
                                <i class="bi bi-cart-plus me-2"></i> Thêm Vào Giỏ Hàng
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100 fw-bold" disabled>
                            <i class="bi bi-x-circle me-2"></i> Sản phẩm đang tạm hết hàng
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related != null && related.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-4">Các Mẫu Tủ Bếp Cùng Chất Liệu Liên Quan</h4>
            <div class="row g-4">
                @foreach (var item in related)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="card card-product h-100 shadow-sm">
                            <div style="height: 180px; overflow: hidden; background-color: #f1f5f9;">
                                <a asp-action="Details" asp-route-id="@item.MaHang">
                                    <img src="/images/products/@item.AnhChinh" class="card-img-top product-img" alt="@item.TenHang" style="height: 180px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/products/no_image.png';">
                                </a>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <h6 class="card-title fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@item.MaHang" class="text-decoration-none text-dark">@item.TenHang</a>
                                </h6>
                                <div class="fw-bold text-danger mt-2">@item.DonGiaBan?.ToString("N0") đ</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .active-thumb .border {
            border-color: #0d6efd !important;
            border-width: 2px !important;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25) !important;
        }
        .thumb-item:hover .border {
            border-color: #0d6efd !important;
            transform: translateY(-2px);
        }
    </style>
    <script>
        $(document).ready(function () {
            // Chuyển đổi góc chụp ảnh khi click thumbnail
            $('.thumb-item').on('click', function () {
                $('.thumb-item').removeClass('active-thumb');
                $(this).addClass('active-thumb');
                var newSrc = $(this).data('src');
                var label = $(this).data('label');

                $('#mainProductImg').css('opacity', '0.4');
                setTimeout(function () {
                    $('#mainProductImg').attr('src', newSrc).css('opacity', '1');
                }, 150);

                $('#imgAngleBadge').html('<i class="bi bi-camera me-1"></i> ' + label);
            });

            var maxQty = @(Model.SoLuong ?? 0);

            $("#btnMinus").click(function () {
                var val = parseInt($("#inputQuantity").val()) || 1;
                if (val > 1) $("#inputQuantity").val(val - 1);
            });

            $("#btnPlus").click(function () {
                var val = parseInt($("#inputQuantity").val()) || 1;
                if (val < maxQty) $("#inputQuantity").val(val + 1);
            });

            $("#btnAddToCart").click(function () {
                var qty = parseInt($("#inputQuantity").val()) || 1;
                var id = $(this).data("id");

                $.ajax({
                    url: "/Cart/AddToCart",
                    type: "POST",
                    data: { id: id, quantity: qty },
                    success: function (res) {
                        if (res.success) {
                            $("#cartCountBadge").text(res.totalCount);
                            $("#toastMessage").html('<i class="bi bi-check-circle-fill me-2"></i>' + res.message);
                            var toast = new bootstrap.Toast($('#cartToast'));
                            toast.show();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });
        });
    </script>
}
