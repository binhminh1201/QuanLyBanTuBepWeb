@model IEnumerable<QuanLyBanTuBepWeb.Models.HoaDonBan>
@{
    ViewData["Title"] = "Quản Lý Hoá Đơn Bán Hàng";
}

<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <!-- Filter by date -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2">
            <label class="small text-muted mb-0">Từ ngày:</label>
            <input type="date" name="tuNgay" class="form-control form-control-sm" style="width: 160px;" value="@ViewBag.TuNgay" />
            <label class="small text-muted mb-0">Đến ngày:</label>
            <input type="date" name="denNgay" class="form-control form-control-sm" style="width: 160px;" value="@ViewBag.DenNgay" />
            <button type="submit" class="btn btn-primary btn-sm px-3"><i class="bi bi-search me-1"></i>Lọc ngày</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
        </form>

        <div>
            <span class="badge bg-light text-dark border p-2">Tổng số hoá đơn: <strong>@Model.Count()</strong></span>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Số HDB</th>
                    <th>Ngày bán</th>
                    <th>Khách hàng</th>
                    <th>Điện thoại</th>
                    <th>Địa chỉ lắp đặt</th>
                    <th>Nhân viên lập</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center" style="width: 80px;">Xem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.SoHDB</td>
                        <td>@item.NgayBan?.ToString("dd/MM/yyyy")</td>
                        <td class="fw-semibold">@(item.KhachHang?.TenKhach ?? "Khách lẻ")</td>
                        <td>@(item.KhachHang?.DienThoai ?? "-")</td>
                        <td>@(item.KhachHang?.DiaChi ?? "-")</td>
                        <td>@(item.NhanVien?.TenNV ?? "N/A")</td>
                        <td class="text-end fw-bold text-danger">@item.TongTien?.ToString("N0") đ</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.SoHDB" class="btn btn-outline-primary btn-sm" title="Xem chi tiết đơn">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
